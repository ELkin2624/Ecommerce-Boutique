PROJECT_NAME="FashionStore API"
API_V1_STR=/api/v1
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fashionstore_db

JWT_SECRET_KEY=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:4200,http://localhost:3000,*

# Storage Configuration (Cloud Agnostic: local, s3, gcs, azure)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_ENDPOINT_URL=

# AI Integration
AI_SERVICE_API_KEY=
AI_SERVICE_BASE_URL=https://api.openai.com/v1
AI_MODEL_NAME=gpt-4o-mini

*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
*.csr
id_rsa*
id_ecdsa*
id_ed25519*

# Credenciales Cloud, Firebase y Cuentas de Servicio
*credentials*.json
*secret*.json
service-account*.json
serviceAccountKey*.json
google-services.json
GoogleService-Info.plist

# Tokens de gestores de paquetes
.npmrc
.pypirc
.netrc


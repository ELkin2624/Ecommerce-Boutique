# ==============================================================================
# SECRETOS, LLAVES Y VARIABLES DE ENTORNO (CRÍTICO DE SEGURIDAD)
# ==============================================================================
# Archivos de entorno
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Exceptuar ejemplos/plantillas para que el equipo sepa qué variables configurar
!.env.example
!.env.template
!.env.sample
!**/.env.example
!**/.env.template
!**/.env.sample


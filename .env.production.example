# ==============================================================================
# CONFIGURACIÓN PARA PRODUCCIÓN (GOOGLE CLOUD RUN + SUPABASE)
# ==============================================================================

# 1. Base de Datos Supabase (Reemplaza con tu URL real de Supabase)
# NOTA: Asegúrate de incluir "?sslmode=require".
# Si usas Connection Pooling (puerto 5432 o 6543), colócalo aquí:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[TU_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# 2. Secretos JWT de Autenticación
JWT_ACCESS_SECRET="genera_una_cadena_aleatoria_larga_y_segura_para_access"
JWT_REFRESH_SECRET="genera_otra_cadena_aleatoria_larga_y_segura_para_refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# 3. Administrador Inicial (Seed)
SEED_ADMIN_EMAIL="admin@fashionstore.com"
SEED_ADMIN_PASSWORD="TuPasswordSeguro123!"

# 4. Flags de arranque (En el primer despliegue a Cloud Run, poner RUN_MIGRATIONS=true)
RUN_MIGRATIONS="true"
RUN_SEED="false"

# 5. Pasarela de Pagos Stripe (Opcional en dev/test)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# 6. Puertos locales (Para pruebas con docker-compose)
BACKEND_PORT=3000
FRONTEND_PORT=80
VITE_API_URL="http://localhost:3000/api/v1"
